# Copy this file to .env and fill in your own values.
# Nothing secret is committed to the repo — these are read at runtime.

# --- Episode catalog + transcripts (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional table-name prefix, so several projects can share one Postgres database.
# Empty = plain `podcast_episodes` / `podcast_transcripts`. Create the tables with
# the matching prefix (see schema.sql).
DB_TABLE_PREFIX=

# --- Inference gateway (OpenAI-compatible) ---
# One base URL + bearer token serves transcription and (optionally) the chat
# answer step. Embeddings are handled by Pinecone, not here.
# Point this at any OpenAI-compatible endpoint (self-hosted or managed).
LLM_BASE_URL=https://your-inference-gateway.example.com
LLM_API_KEY=your-gateway-token

# --- Models ---
# LLM_MODEL is the local-gateway chat model, used for answers only if
# ANSWER_LLM_BASE_URL below is unset. (Embeddings are handled by Pinecone.)
LLM_MODEL=gemma4:e4b

# --- Answer synthesis on a separate fast endpoint (optional) ---
# Route the query-time chat answer to a faster, OpenAI-compatible endpoint (e.g.
# Google AI Studio) so search stays responsive while the local gateway transcribes.
# Leave blank to use the local gateway (LLM_BASE_URL) for answers too.
# Example (Google AI Studio) — prefer a "lite" model for a generous free-tier
# daily quota (the headline flash models cap at ~20 free requests/day):
#   ANSWER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   ANSWER_LLM_MODEL=gemini-2.5-flash-lite
ANSWER_LLM_BASE_URL=
ANSWER_LLM_API_KEY=
ANSWER_LLM_MODEL=

# --- Vector store + search (Pinecone, integrated embedding) ---
# Pinecone hosts the embedding model and embeds both the upserted chunk text and
# the search query — the app never computes embeddings. Create an index with an
# integrated model (e.g. llama-text-embed-v2, 768-dim, cosine, text field "text").
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_HOST=https://your-index-xxxx.svc.region.pinecone.io
PINECONE_NAMESPACE=__default__
PINECONE_TEXT_FIELD=text

# --- Oversize-audio handling (optional) ---
# Where ffmpeg writes compressed audio, and the public base URL it's served from
# so the transcription gateway can fetch episodes over 50 MB.
TEMP_AUDIO_DIR=/tmp/podsearch_audio
LIVE_AUDIO_BASE_URL=

# --- Access control ---
# Comma-separated API keys accepted on the /mcp endpoint (sent as X-API-Key).
# Leave empty for local-only use; always set this in a shared deployment.
MCP_API_KEYS=

# Comma-separated hosts allowed to reach the SSE MCP endpoint, e.g. your
# deployment domain. Localhost is always allowed.
MCP_ALLOWED_HOSTS=

# --- Live crawler relay (optional) ---
# When set, a remote crawler POSTs progress events to production so the live
# site can show what's being transcribed in real time. Empty = disabled.
LIVE_RELAY_URL=
